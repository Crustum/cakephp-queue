{
    "name": "crustum/cakephp-queue",
    "description": "CakePHP queue helpers: Dispatchable / Configurable / Taggable job contracts",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": [
        "cakephp",
        "queue",
        "jobs",
        "dispatchable",
        "sync jobs"
    ],
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/cakephp": "^5.4",
        "cakephp/queue": "^2.3",
        "symfony/polyfill-php84": "^1.31",
        "crustum/plugin-manifest": "^1.0.2",
        "ramsey/uuid": "^4.7",
        "crustum/cakephp-attribute-resolver": "^1.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.3",
        "enqueue/simple-client": "^0.10.27",
        "enqueue/dsn": "^0.10.27",
        "enqueue/null": "^0.10.27",
        "enqueue/enqueue": "^0.10.27",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.1 || ^12.5 || ^13.0",
        "queue-interop/queue-interop": "^0.8.2",
        "rector/rector": "^2.6",
        "symfony/config": "^7.3|^8.0"
    },
    "suggest": {
        "laravel/serializable-closure": "Packs queued then/catch callbacks (CallbackProcessor)."
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\Queue\\Test\\": "tests/",
            "TestApp\\": "tests/TestApp/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse",
        "stan-baseline": "phpstan analyse --generate-baseline"
    },
    "extra": {
        "installer-name": "Queue"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
